<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Suno's player lives here, hidden behind the stage -->
    <FrameLayout
        android:id="@+id/engine_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<com.echoes.silverback.StageLayout
    android:id="@+id/stage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/silverback_overlay" />

    <!-- Animated Silverback After Dark loop (plays over the still art) -->
    <TextureView
        android:id="@+id/stage_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Code effects on top of the video: fog + embers -->
    <com.echoes.silverback.EffectsView
        android:id="@+id/effects"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Song window: designed at 1095x462 px, scaled into the overlay's black screen -->
    <FrameLayout
        android:id="@+id/window"
        android:layout_width="1095px"
        android:layout_height="462px">

        <LinearLayout
            android:id="@+id/now_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="32px">

            <FrameLayout
                android:layout_width="360px"
                android:layout_height="360px"
                android:background="@drawable/cover_frame"
                android:padding="4px">

                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <!-- animated (video) cover art -->
                <TextureView
                    android:id="@+id/cover_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_marginStart="44px"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.25"
                    android:text="NOW PLAYING"
                    android:textColor="@color/sb_red"
                    android:textSize="22px"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8px"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="@color/sb_red"
                    android:shadowRadius="12"
                    android:textColor="#FFFFFF"
                    android:textSize="48px"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4px"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#C9C9C9"
                    android:textSize="30px" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8px"
                    android:layout_marginTop="28px"
                    android:progressDrawable="@drawable/progress_red" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8px"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/elapsed"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#9A9A9A"
                        android:textSize="22px" />

                    <TextView
                        android:id="@+id/total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#9A9A9A"
                        android:textSize="22px" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22px"
                    android:letterSpacing="0.25"
                    android:text="UP NEXT"
                    android:textColor="@color/sb_red"
                    android:textSize="20px"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/up_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6px"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2px"
                    android:maxLines="3"
                    android:textColor="#B5B5B5"
                    android:textSize="21px" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.2"
            android:shadowColor="@color/sb_red"
            android:shadowRadius="14"
            android:text="WAITING FOR THE NEXT TRACK"
            android:textColor="#E6E6E6"
            android:textSize="34px"
            android:textStyle="bold" />

        <!-- DEBUG panel: tap it to close -->
        <ScrollView
            android:id="@+id/debug_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2000000"
            android:padding="14px"
            android:visibility="gone">

            <TextView
                android:id="@+id/debug_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#7CFF7C"
                android:textSize="15px" />
        </ScrollView>

        <!-- Volume readout, shows briefly when you change volume -->
        <TextView
            android:id="@+id/vol_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16px"
            android:background="@drawable/controls_bg"
            android:paddingStart="18px"
            android:paddingTop="8px"
            android:paddingEnd="18px"
            android:paddingBottom="8px"
            android:textColor="#FFFFFF"
            android:textSize="22px"
            android:textStyle="bold"
            android:visibility="gone" />


    </FrameLayout>

    <!-- Controls along the bottom of the stage (tap the stage to show for 4 seconds) -->
    <FrameLayout
        android:id="@+id/art_ui"
        android:layout_width="1672px"
        android:layout_height="941px">

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16px"
            android:background="@drawable/controls_bg"
            android:orientation="horizontal"
            android:padding="6px"
            android:visibility="gone">

            <TextView android:id="@+id/btn_play" style="@style/StageButton" android:text="PLAY" />
            <TextView android:id="@+id/btn_skip" style="@style/StageButton" android:text="SKIP" />
            <TextView android:id="@+id/btn_debug" style="@style/StageButton" android:text="DEBUG" android:visibility="gone" />
            <TextView android:id="@+id/btn_mini" style="@style/StageButton" android:text="MINI" />
            <TextView android:id="@+id/btn_discord" style="@style/StageButton" android:text="DISCORD" />
            <TextView android:id="@+id/btn_queue" style="@style/StageButton" android:text="QUEUE" />
            <TextView android:id="@+id/btn_paste" style="@style/StageButton" android:text="PASTE LINK" />
            <TextView android:id="@+id/btn_clear" style="@style/StageButton" android:text="CLEAR" android:visibility="gone" />
            <TextView android:id="@+id/btn_vol_down" style="@style/StageButton" android:text="VOL −" />
            <TextView android:id="@+id/btn_vol_up" style="@style/StageButton" android:text="VOL +" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bananas fall when a song gets added -->
    <com.echoes.silverback.BananaRainView
        android:id="@+id/banana_rain"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</com.echoes.silverback.StageLayout>
</FrameLayout>
